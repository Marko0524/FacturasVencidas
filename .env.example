# Copy to .env and fill in. Never commit the real .env file.

# Leave empty to read invoices from sample_data/invoices.json (no network needed).
INVOICES_API_URL=

# Sent as "Authorization: Bearer <token>". Leave empty for unauthenticated APIs.
# In production this comes from Azure Key Vault / Managed Identity, never from a file.
API_TOKEN=

# Buzón temporal real, para validar la alerta contra Mailpit.
OPERATIONS_EMAIL=o5n3it82yy@lnovic.com

# HTTP behaviour
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_BACKOFF_BASE=0.5

# Business rule: more than this many days overdue also alerts Operations.
OVERDUE_ALERT_THRESHOLD_DAYS=10

# Paths (relative paths resolve against the project root)
STATE_FILE_PATH=./state/notifications.json
SAMPLE_DATA_PATH=./sample_data/invoices.json

LOG_LEVEL=INFO

# true = simulate everything but do not persist the idempotency state,
# so the full flow can be demonstrated repeatedly.
DRY_RUN=false

# --- Notification delivery -------------------------------------------------
# log  = simulate the send with log lines (default, no network).
# smtp = build and send real e-mail through the SMTP server below.
NOTIFICATION_CHANNEL=log

# Defaults point at Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit),
# which accepts every message and shows it at http://localhost:8025 without
# forwarding anything to the internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

EMAIL_FROM=cobranza@empresa.com
EMAIL_FROM_NAME=Cobranza Empresa
