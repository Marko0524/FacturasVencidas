# Copia este archivo a asistente/.env y rellena lo que vayas a usar.
# .env está ignorado por Git: aquí sí pueden ir llaves.

# fake   = sin red, sin llaves, sin costo. Ejercita el flujo completo.
# azure  = Azure OpenAI
# gemini = Google AI Studio (clave estática)
# vertex = Google Vertex AI (cuenta de servicio, sin clave estática)
LLM_PROVIDER=fake

# memoria  = índice en memoria sobre el corpus del repositorio (default)
# postgres = pgvector; es lo que habilita la carga de documentos
RETRIEVAL_BACKEND=memoria
DATABASE_URL=postgresql://asistente:asistente@localhost:5432/asistente

# --- Azure OpenAI --------------------------------------------------------
# El "deployment" es el nombre que le pusiste tú al publicar el modelo en
# Azure AI Foundry; no es el nombre del modelo.
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini -------------------------------------------------------
# Llave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Vertex AI -----------------------------------------------------------
# Ruta al JSON de la cuenta de servicio. El proyecto sale del propio archivo
# salvo que lo fijes aquí. `global` alcanza los modelos más nuevos.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_CHAT_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001

# --- Recuperación --------------------------------------------------------
# Cuántos fragmentos se pasan al modelo como evidencia.
RETRIEVAL_TOP_K=4
# Piso de similitud. Si lo dejas vacío se usa el default del proveedor:
# 0.55 para azure/gemini/vertex, 0.15 para fake (no comparten escala).
RETRIEVAL_MIN_SIMILARITY=

LLM_REQUEST_TIMEOUT=30
MAX_QUESTION_CHARS=800
LOG_LEVEL=INFO
